package app2;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.client.RestTemplate;


@RestController
public class Controller {





@GetMapping(value="/pedir")
public String pedirUsuario(@RequestParam(name="codusu") int param) {
	int codUsu=param;
	String cogerUsuario="http://localhost:8080/darUsuario?"+codUsu;
	RestTemplate restTemplate = new RestTemplate();
	Usuario u1= restTemplate.getForObject(cogerUsuario, Usuario.class);
	return u1.toString();
}

	@GetMapping(value="/saludar")
	public String saludar(@RequestParam(name="nombre") String nombre) {
		return "Hola, usuario "+nombre;
	}


}
